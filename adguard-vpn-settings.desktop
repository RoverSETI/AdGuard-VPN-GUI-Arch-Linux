[Desktop Entry]
Type=Application
Name=AdGuard VPN — Настройки / Settings
Comment=Панель настроек AdGuard VPN CLI / AdGuard VPN CLI settings panel
# RU: поменяйте путь, если положили файл не в ~/.local/bin
# EN: adjust the path if you placed the file elsewhere
Exec=/bin/sh -c 'exec python3 "$HOME/.local/bin/adguard-vpn-gui.py"'
Icon=network-vpn
Terminal=false
Categories=Network;Settings;
StartupNotify=false
